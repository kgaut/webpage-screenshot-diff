{
  "name": "screenshot-diff",
  "version": "0.1.0",
  "description": "HTTP service that captures URL screenshots and compares them against the previous batch to detect visual regressions.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "cd web && npm install --no-audit --no-fund && npm run build",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:web": "cd web && npm run dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
